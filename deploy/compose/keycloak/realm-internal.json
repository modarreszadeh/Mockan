  "clients": [
    {
      "clientId": "mockan",
      "name": "Mockan (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "mockan-local-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/api/v1/auth/callback",
        "http://localhost:5173/api/v1/auth/callback",
        "http://localhost:5174/api/v1/auth/callback"
      ],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "mockan-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mockan",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
