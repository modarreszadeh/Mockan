# Copy to `.env` (same folder); Docker Compose reads it automatically and `.env` is git-ignored.

# The full public base URL developers use (VITE_API_BASE_URL=<this>/<slug>), including the nginx
# mount path. The Panel's displayed and copied URLs and the Gateway's redirect/cookie rewriting all
# read it. Keep the port in step with MOCKAN_PORT (default 8765).
# Examples: http://localhost:8765/mock  |  https://mock.example.com/mock
MOCKAN_PUBLIC_BASE_URL=http://localhost:8765/mock
