# Production settings. deploy.sh creates `.env` from this file on the first run and fills the
# values marked "generated". You fill the ones marked "required" (it stops and lists them).
# Secrets are never printed. `.env` is git-ignored; keep it chmod 600.

# -- Images ---------------------------------------------------------------------------------------
# Where CI publishes the images (<repo>/admin and <repo>/gateway). Public: no docker login needed.
MOCKAN_IMAGE_REPO=ghcr.io/modarreszadeh/mockan
# `latest`, a branch, or a git SHA. deploy.sh <tag> sets it for you.
IMAGE_TAG=latest

# -- Edge -----------------------------------------------------------------------------------------
# nginx is the only published port. Use 127.0.0.1 when a TLS reverse proxy on this host forwards to
# it; use 0.0.0.0 when the proxy is on another host.
MOCKAN_BIND=127.0.0.1
MOCKAN_PORT=8765
# The nginx image. Set it to one the server already has when Docker Hub is not reachable (it is only
# pulled when missing).
MOCKAN_NGINX_IMAGE=nginx:1-alpine
# required: the public address developers use, including the nginx mount path (see README).
# The Panel's displayed/copied URLs and the Gateway's redirect/cookie rewriting read it.
MOCKAN_PUBLIC_BASE_URL=https://mockan.novin-tools.com/mock

# -- Database ---------------------------------------------------------------------------------------
# bundled  : deploy.sh runs a PostgreSQL container next to the app and generates its password.
# external : use a shared PostgreSQL that is reachable on a Docker network (below). Create a role and
#            database for Mockan there, then put the URL in MOCKAN_DATABASE_URL.
MOCKAN_DB_MODE=bundled
# external mode only: the existing Docker network the shared PostgreSQL is on.
MOCKAN_DB_NETWORK=pg
# generated in bundled mode; required in external mode. The scheme must be postgresql+asyncpg://
# (host = the shared PostgreSQL's name on that network). Connect directly or through a session-pooled
# endpoint: the Gateway uses LISTEN/NOTIFY and advisory locks, which transaction pooling breaks.
MOCKAN_DATABASE_URL=
# bundled mode only, generated: letters, digits and . _ ~ - only. Changing it later does not change
# the password inside an existing database.
POSTGRES_PASSWORD=

# -- Upstreams ------------------------------------------------------------------------------------
# required: JSON list of the dev/stage hosts Mockan may proxy to (`*.x` matches subdomains only).
# Never list production hosts.
MOCKAN_ALLOWED_UPSTREAM_HOSTS='["*.novin-stage.com"]'

# -- Sign-in (OIDC / Keycloak; dev mode is never used in production) -------------------------------
# required: the realm URL, e.g. https://sso.example.com/realms/internal
MOCKAN_OIDC_ISSUER=
# required
MOCKAN_OIDC_CLIENT_ID=
# required (secret): type it on the server, never commit it.
MOCKAN_OIDC_CLIENT_SECRET=
# required: JSON list of the `sub` values that are admins, e.g. '["<keycloak-user-id>"]'
MOCKAN_ADMIN_SSO_SUBJECTS=
# generated: 64 hex characters; the same value on every Admin replica.
MOCKAN_SESSION_SECRET=
