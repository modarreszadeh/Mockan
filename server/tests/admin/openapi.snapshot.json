  "paths": {
    "/api/v1/auth/callback": {
      "get": {
        "operationId": "auth_callback_api_v1_auth_callback_get",
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not signed in (`unauthenticated`)."
          }
        },
        "summary": "OIDC redirect target",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "description": "OIDC: redirect to the identity provider. Dev mode (G-9): sign in as `dev:<as>` directly.",
        "operationId": "login_api_v1_auth_login_get",
        "parameters": [
          {
            "description": "Dev mode only: who to sign in as.",
            "in": "query",
            "name": "as",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9._-]{1,50}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev mode only: who to sign in as.",
              "title": "As"
            }
          },
          {
            "description": "Dev mode only: sign in as an admin.",
            "in": "query",
            "name": "admin",
            "required": false,
            "schema": {
              "default": false,
              "description": "Dev mode only: sign in as an admin.",
              "title": "Admin",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the IdP (or the Panel)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`validation_failed` (or `upstream_host_not_allowed`) with field `errors`."
          }
        },
        "summary": "Start sign-in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
