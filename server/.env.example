# Mockan settings (arch §12.3). Copy to .env for local development. All variables use the MOCKAN_ prefix.
# JSON lists must be valid JSON.

# --- both processes ---
MOCKAN_DATABASE_URL=postgresql+asyncpg://mockan:mockan@localhost:5432/mockan
MOCKAN_ALLOWED_UPSTREAM_HOSTS=["identity.stage.internal","*.dev.internal"]
MOCKAN_PUBLIC_BASE_URL=https://mock.novin-tools.com
MOCKAN_DEFAULT_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]
MOCKAN_LOG_LEVEL=INFO
# json | console
MOCKAN_LOG_FORMAT=json

# --- admin ---
# oidc | dev. `dev` signs in without an identity provider: MUST NOT be used in shared environments (G-9).
MOCKAN_AUTH_MODE=oidc
# In dev mode the Panel's bare /auth/login signs in as `dev:dev`; list it below to make that user an admin.
# TODO(OQ-04): generic OIDC; provider specifics undecided.
MOCKAN_OIDC_ISSUER=
MOCKAN_OIDC_CLIENT_ID=
MOCKAN_OIDC_CLIENT_SECRET=
# Random, 32+ bytes.
MOCKAN_SESSION_SECRET=change-me-change-me-change-me-change-me
# Bootstrap list of sso_subjects that get is_admin=true on first login.
MOCKAN_ADMIN_SSO_SUBJECTS=[]
MOCKAN_MIGRATE_ON_STARTUP=false
# TODO(OQ-03): where the Panel is served from.
MOCKAN_PANEL_BASE_PATH=/

# --- gateway ---
MOCKAN_SNAPSHOT_RELOAD_SECONDS=60
MOCKAN_SNAPSHOT_DEBOUNCE_MS=200
